<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#FAFAFA">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nearby Shelter Alert Mode"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:layout_gravity="center_horizontal"
        android:paddingBottom="24dp" />

    <RadioGroup
        android:id="@+id/modeGroup"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:padding="16dp"
        android:clipToPadding="false">

        <RadioButton
            android:id="@+id/modeOff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Off"
            android:padding="12dp"
            android:textSize="18sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginVertical="8dp"/>

        <RadioButton
            android:id="@+id/modeAlertOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Trigger only on ALERT_MESSAGE"
            android:padding="12dp"
            android:textSize="18sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginVertical="8dp"/>

        <RadioButton
            android:id="@+id/modeWarningAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Trigger on WARNING_MESSAGE or ALERT_MESSAGE"
            android:padding="12dp"
            android:textSize="18sp" />

    </RadioGroup>

    <TextView
        android:id="@+id/infoText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select a mode. The app will automatically open Google Maps to the nearest shelter according to the chosen mode."
        android:textSize="14sp"
        android:textColor="#616161"
        android:paddingTop="24dp" />

</LinearLayout>